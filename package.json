{
  "name": "ai-ttrpg-engine",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "npm run dev",
    "test": "node --test --test-timeout=30000 --test-force-exit test/*.test.mjs",
    "dev": "concurrently -k \"node --env-file-if-exists=.env server/index.js\" \"vite\"",
    "play:necrotopia": "concurrently -k \"TTRPG_WORLD=campaigns/necrotopia TTRPG_RULESET=necrotopia node --env-file-if-exists=.env server/index.js\" \"vite\"",
    "server": "node --env-file-if-exists=.env server/index.js",
    "worldgen": "node --env-file-if-exists=.env tools/worldgen.mjs",
    "smoke:necrotopia": "node tools/smoke-necrotopia.mjs",
    "client": "vite"
  },
  "dependencies": {
    "concurrently": "^9.1.2",
    "openai": "^6.42.0",
    "vite": "^6.3.0",
    "ws": "^8.18.0",
    "zod": "^3.25.0"
  }
}
