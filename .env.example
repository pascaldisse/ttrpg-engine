# Copy to .env and fill in. The server loads .env via --env-file (keys stay server-side).
# LLM_PROVIDER selects the adapter: "deepseek" (real) or "mock" (no key, deterministic).
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=sk-your-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# Scene art: "pollinations" (free, keyless — the default), "mock" (offline SVG),
# or "openai" (uses OPENAI_API_KEY, gpt-image-1 access required).
ART_PROVIDER=pollinations
